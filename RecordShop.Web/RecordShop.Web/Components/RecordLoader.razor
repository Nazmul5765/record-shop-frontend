@using RecordShop.Web.Components
@using RecordShop.Web.Models
@using System.Net.Http.Json

@if (errorMessage != null)
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}
else if (record == null)
{
    <p class="text-light opacity-75">Loading record...</p>
}
else
{
    <RecordDetails Record="record" />
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Record? record;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = new HttpClient();

            record = await http.GetFromJsonAsync<Record>(
            $"https://localhost:7060/api/albums/{Id}"

            );

        } catch (Exception ex)
        {
            errorMessage = $"could not load record: {ex.Message}";
        }
    }

}
