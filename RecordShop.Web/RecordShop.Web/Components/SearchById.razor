@using RecordShop.Web.Components
@using RecordShop.Web.Models
@inject HttpClient http

<div class="card bg-dark text-light border-secondary h-100">
    <div class="card-body">
        <h3 class="card-title">Search by ID</h3>
        <p class="search-card-description text-light opacity-75">Enter a record ID to find one exact album.</p>

        <div class="input-group mb-3">
            <InputNumber class="form-control" @bind-Value="Id"></InputNumber>
            <button class="btn btn-primary" type="button" @onclick="_searchById">Search</button>
        </div>

        @if (_errorMessage != null)
        {
            <div class="alert alert-warning">
                @_errorMessage
            </div>
        }
        else if (Record != null)
        {
            <RecordSummary Record="Record" />
        }
    </div>
</div>

@code {
    public int Id { get; set; }
    public Record? Record { get; set; }
    private string? _errorMessage;

    private async Task _searchById()
    {
        try
        {
            if (Id <= 0)
            {
                _errorMessage = "Enter a valid Id";
                Record = null;
                return;
            }

            Record = await http.GetFromJsonAsync<Record>(
                $"api/albums/{Id}"
            );

            _errorMessage = null;


        } catch (Exception)
        {
            Record = null;
            _errorMessage = "No record found with that Id";
        }
    }

}
