@using Microsoft.AspNetCore.Components
@page "/records/{Id:int}"

<div class="mb-4">
    <h1 class="text-white fw-bold">Record Details</h1>
    <p class="text-light opacity-75">View, update, or remove this record from the catalogue.</p>
</div>

<RecordLoader Id="Id" />

@code {
    [Parameter]
    public int Id { get; set; }

}
