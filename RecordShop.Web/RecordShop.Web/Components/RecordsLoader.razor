@using RecordShop.Web.Models
@using RecordShop.Web.Components
@using System.Net.Http.Json
@using RecordShop.Web.Services
@inject ApiClient ApiClient

@if (errorMessage != null)
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}
else if (records == null)
{
    <p class="text-light opacity-75">Loading records...</p>
}
else
{
    <CascadingValue Value="records">
        @ChildContent
    </CascadingValue>
     


}

@code {
    private List<Record>? records;
    private string? errorMessage;
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        
        try
        {

                records = await ApiClient.GetWithRetryAsync<List<Record>>(
                "api/albums"

            );
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load records: {ex.Message}";
        }
        
    }
}
