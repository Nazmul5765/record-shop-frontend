@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using RecordShop.Web.Models

<div class="card bg-dark text-light mx-auto shadow-sm border-secondary" style="max-width: 600px;">
    <div class="card-body">
        <h3 class="card-title mb-1">@Record.Title</h3>
        <p class="text-light opacity-75 mb-4">@Record.Artist</p>

        <EditForm Model="Record" OnValidSubmit="SaveChanges">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="Record.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Artist</label>
                <InputText class="form-control" @bind-Value="Record.Artist" />
            </div>

            <div class="mb-3">
                <label class="form-label">Genre</label>
                <InputText class="form-control" @bind-Value="Record.Genre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Release Year</label>
                <InputNumber class="form-control" @bind-Value="Record.ReleaseYear" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <InputNumber class="form-control" @bind-Value="Record.Price" />
            </div>

            <div class="mb-3">
                <label class="form-label">Stock Quantity</label>
                <InputNumber class="form-control" @bind-Value="Record.StockQuantity" />
            </div>

            <button class="btn btn-primary" type="submit">Save Changes</button>
        </EditForm>

        <hr />

        <button class="btn btn-outline-danger" type="button" @onclick="ShowDeleteConfirmation">
            Delete Record
        </button>

        @if (showDeleteConfirmation)
        {
            <div class="alert alert-warning mt-3">
                <p class="mb-3">Are you sure you want to delete this record?</p>
                <button class="btn btn-danger me-2" type="button" @onclick="DeleteRecord">Yes, delete</button>
                <button class="btn btn-secondary" type="button" @onclick="CancelDelete">No, cancel</button>
            </div>
        }

        @if (savedMessage != null)
        {
            <div class="alert alert-info mt-3">
                @savedMessage
            </div>
        }
    </div>
</div>


@code {
    private string? savedMessage;
    private bool showDeleteConfirmation = false;
    [Parameter]
    public Record Record { get; set; } = default!;

    private async Task SaveChanges()
    {
        try
        {
            var httpClient = new HttpClient();
            var response = await httpClient.PutAsJsonAsync(
                $"https://localhost:7060/api/albums/{Record.Id}", Record
            );

            if (response.IsSuccessStatusCode)
            {
                savedMessage = "Record updated successfully";   
            }
            else
            {
                savedMessage = "Could not update record.";
            }

        } catch (Exception ex)
        {
            savedMessage = $"Error updating record: {ex.Message}";
        }
    }

    private async Task DeleteRecord()
    {
        try
        {
            var httpClient = new HttpClient();
            var response = await httpClient.DeleteAsync(
                $"https://localhost:7060/api/albums/{Record.Id}");

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/records");   
            }
        } catch (Exception ex)
        {
            savedMessage = $"Error deleting record {ex.Message}";
        }
    }

    private void ShowDeleteConfirmation()
    {
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;   
    }

}
 
