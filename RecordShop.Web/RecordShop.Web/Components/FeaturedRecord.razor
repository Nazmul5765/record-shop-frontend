@using RecordShop.Web.Models
@using RecordShop.Web.Components
<h3>FeaturedRecord</h3>



@if (errorMessage != null)
{
    <p>@errorMessage</p>
}
else if (featuredRecord == null)
{
    <p>Loading records</p>
}
else
{
    <RecordSummary Record="featuredRecord" />
}


@code {
    private Record? featuredRecord;
    private string? errorMessage;
    [CascadingParameter]
    public List<Record>? Records { get; set; }

    protected override void OnParametersSet()
    {
        try
        {

            if (Records == null || Records.Count == 0)
            {
                errorMessage = "No records found";
            } 
            else
            {
                Random random = new Random();
                var index = random.Next(Records.Count);
                featuredRecord = Records[index];
            }

        } catch (Exception ex)
        {
            errorMessage = $"Could not load featured record: {ex.Message}";
        }
    }

}
