@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@using RecordShop.Web.Models
@using RecordShop.Web.Components


<div class="card bg-dark text-light mx-auto shadow-sm border-primary" style="max-width: 600px;">
    <div class="card-body">
        <h4 class="card-title mb-4">Record Details</h4>

        <EditForm Model="newRecord" OnValidSubmit="submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="newRecord.Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Artist</label>
                <InputText class="form-control" @bind-Value="newRecord.Artist" />
            </div>

            <div class="mb-3">
                <label class="form-label">Genre</label>
                <InputText class="form-control" @bind-Value="newRecord.Genre" />
            </div>

            <div class="mb-3">
                <label class="form-label">Release Year</label>
                <InputNumber class="form-control" @bind-Value="newRecord.ReleaseYear" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <InputNumber class="form-control" @bind-Value="newRecord.Price" />
            </div>

            <div class="mb-3">
                <label class="form-label">Stock Quantity</label>
                <InputNumber class="form-control" @bind-Value="newRecord.StockQuantity" />
            </div>

            <button class="btn btn-primary" type="submit">Add Record</button>
        </EditForm>

        @if (createdMessage != null)
        {
            <div class="alert alert-success mt-3">
                @createdMessage
            </div>
        }
    </div>
</div>

@code {
    private string? createdMessage;
    private Record newRecord = new Record();

    private async Task submit()
    {
        try
        {
            HttpClient httpClient = new HttpClient();
            var response = await httpClient.PostAsJsonAsync(
            "https://localhost:7060/api/albums", newRecord
            );

            if (response.IsSuccessStatusCode)
            {
                createdMessage = "New record added successfully";
                // Navigation.NavigateTo("/records");
                newRecord = new Record();
            }
            else
            {
                createdMessage = "Could not add record.";
            }

        } catch (Exception ex)
        {
            createdMessage = "Error adding new record: " + ex.Message;
        }
    }

}
