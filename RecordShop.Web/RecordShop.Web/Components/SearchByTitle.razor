@using RecordShop.Web.Components
@using RecordShop.Web.Models
@inject HttpClient http
<div class="card bg-dark text-light border-secondary h-100">
    <div class="card-body">
        <h3 class="card-title">Search by Title</h3>
        <p class="search-card-description text-light opacity-75">Search for a record using its album title.</p>

        <div class="input-group mb-3">
            <InputText class="form-control" @bind-Value="Title"></InputText>
            <button class="btn btn-primary" type="button" @onclick="_searchByTitle">Search</button>
        </div>

        @if (_errorMessage != null)
        {
            <div class="alert alert-warning">
                @_errorMessage
            </div>
        }
        else if (Record != null)
        {
            <RecordSummary Record="Record" />
        }
    </div>
</div>

@code {
    public string Title { get; set; } = string.Empty;
    public Record? Record { get; set; }
    private string? _errorMessage;

    private async Task _searchByTitle()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Title))
            {
                _errorMessage = "Enter a valid Title";
                Record = null;
                return;
            }

            Record = await http.GetFromJsonAsync<Record>(
                $"api/albums/title/{Title}"
            );

            _errorMessage = null;


        }
        catch (Exception)
        {
            Record = null;
            _errorMessage = "No record found with that title";
        }
    }

}
