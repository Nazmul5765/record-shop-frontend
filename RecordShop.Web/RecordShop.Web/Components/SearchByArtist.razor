@using RecordShop.Web.Components
@using RecordShop.Web.Models

<div class="card bg-dark text-light border-secondary h-100">
    <div class="card-body">
        <h3 class="card-title">Search by Artist</h3>
        <p class="text-light opacity-75">Find records by the artist name.</p>

        <div class="input-group mb-3">
            <InputText class="form-control" @bind-Value="Artist"></InputText>
            <button class="btn btn-primary" type="button" @onclick="_searchByArtist">Search</button>
        </div>

        @if (_errorMessage != null)
        {
            <div class="alert alert-warning">
                @_errorMessage
            </div>
        }
        else if (Records != null)
        {
            @foreach (Record record in Records)
            {
                <RecordSummary Record="record" />
            }
        }
    </div>
</div>

@code {
    public string Artist { get; set; } = string.Empty;
    public List<Record>? Records { get; set; }
    private string? _errorMessage;

    private async Task _searchByArtist()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Artist))
            {
                _errorMessage = "Enter a valid Artist";
                Records = null;
                return;
            }
            HttpClient httpClient = new HttpClient();

            Records = await httpClient.GetFromJsonAsync<List<Record>>(
                $"https://localhost:7060/api/albums/artist/{Artist}"
            );

            _errorMessage = null;


        }
        catch (Exception)
        {
            Records = null;
            _errorMessage = "No record found with that artist";
        }
    }

}
